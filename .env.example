# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase (supabase-js client — lib/supabase.ts)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase (@supabase/server — new publishable/secret key pair, same project)
SUPABASE_URL=your_supabase_project_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=your_supabase_project_url/auth/v1/.well-known/jwks.json

# Command Dashboard Auth (legacy FORGE Lite shared-password fallback)
COMMAND_PASSWORD=your_secure_consultant_password

# VDOS consultant session signing secret (used by lib/auth.ts to sign/verify JWT cookies)
SESSION_SECRET=a_long_random_string

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
